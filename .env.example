# Copy to .env.local and fill in. Server-side only; see docs/explain-service.md.
# Without the three FOUNDRY_* values the /api/explain endpoint answers 503 not-configured.
FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com
FOUNDRY_API_KEY=<your-api-key>
FOUNDRY_DEPLOYMENT=<your-analyst-deployment>

# Required for browser AI access. Generate separate random secrets; never use these placeholders.
# Access code: 16–256 characters. Signing secret: at least 32 characters.
PITCHLENS_JUDGE_ACCESS_CODE=<random-access-code>
PITCHLENS_SESSION_SECRET=<separate-random-signing-secret>
# Local development alternative: omit the two settings above and explicitly opt in below.
# PITCHLENS_ACCESS_MODE=local
# Local mode is refused in production. Default access fails closed.

# Single-process usage controls (see docs/security-controls.md).
# PITCHLENS_DAILY_TOKEN_BUDGET=1000000
# PITCHLENS_SESSION_EXPLANATIONS=30
# Emergency stop: blocks all explanation requests, including cached answers.
# PITCHLENS_EXPLANATIONS_DISABLED=1

# Optional
# FOUNDRY_VERIFIER_DEPLOYMENT=<your-verifier-deployment>
# FOUNDRY_STRUCTURED_OUTPUT=json_schema
# Only set when the deployed model supports this setting (applies to both roles).
# FOUNDRY_REASONING_EFFORT=none
# Optional: a different setting for the verifier (defaults to the analyst's).
# FOUNDRY_VERIFIER_REASONING_EFFORT=none
# FOUNDRY_TEMPERATURE=0
# Deployment request quota: spaces analyst and verifier calls sharing a deployment.
# Set from your allocated quota; token limits can still throttle before this request limit.
# FOUNDRY_REQUESTS_PER_MINUTE=60
# PITCHLENS_ALLOWED_ORIGINS=https://<your-preview-host>
# Machine clients only; never ship this bearer token to the browser.
# PITCHLENS_EXPLAIN_ACCESS_TOKEN=<random-token>

# Opt-in live evaluation (npm run test:live); makes paid model calls.
# See docs/ai-evaluation.md.
# PITCHLENS_LIVE_EVAL=1
# PITCHLENS_LIVE_REQUIRE_EXPLANATION=1
# Default: 65000 ms between the end of one workflow and start of the next.
# PITCHLENS_LIVE_COOLDOWN_MS=65000
# Default: strict coverage and quality gate. Use 0 only for exploratory diagnostics.
# PITCHLENS_LIVE_RELEASE_GATE=1
# PITCHLENS_LIVE_SCENARIOS=default
# PITCHLENS_LIVE_AUDIENCES=casual,analyst
# PITCHLENS_LIVE_MAX_CASES=14
# PITCHLENS_LIVE_MAX_MODEL_CALLS=112
# Prices per million tokens, from your deployment's price sheet (cost is not estimated without them).
# PITCHLENS_PRICE_INPUT_PER_MTOK=
# PITCHLENS_PRICE_OUTPUT_PER_MTOK=
# PITCHLENS_PRICE_VERIFIER_INPUT_PER_MTOK=
# PITCHLENS_PRICE_VERIFIER_OUTPUT_PER_MTOK=
# PITCHLENS_PRICE_CURRENCY=USD
# Optional copy of the Markdown report; use a git-ignored path or one outside the repository.
# PITCHLENS_LIVE_REPORT=

# Opt-in Microsoft Foundry cloud evaluation of the live answers (informational;
# never changes the release gate). Makes paid judge-model calls. See docs/ai-evaluation.md.
# Authenticates with DefaultAzureCredential (locally: `az login`); no key. Needs the
# Foundry User role on the project and a GPT chat-completion judge deployment in it.
# PITCHLENS_FOUNDRY_EVAL=1
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_EVAL_JUDGE_DEPLOYMENT=<your-judge-deployment>
# Rows sent per run (default 28, at most 60) and polling time per run (default 900000 ms).
# PITCHLENS_FOUNDRY_MAX_ROWS=28
# PITCHLENS_FOUNDRY_TIMEOUT_MS=900000
# Content safety and indirect attack on adversarial rows; 0 skips them (for unsupported regions).
# PITCHLENS_FOUNDRY_SAFETY=1
# Standalone scoring of an earlier run (npm run eval:foundry):
# PITCHLENS_FOUNDRY_PROGRESS=<PITCHLENS_LIVE_REPORT>.progress.json
# PITCHLENS_FOUNDRY_REPORT=
