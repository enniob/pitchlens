{
  "name": "pitchlens",
  "version": "0.1.0",
  "private": true,
  "description": "Explainable synthetic football intelligence with interactive 3D playback and Microsoft Foundry.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.mts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
